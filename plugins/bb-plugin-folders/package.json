{
  "name": "bb-plugin-folders",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bb": ">=0.46",
    "bbPluginSdk": ">=0.6.49"
  },
  "bb": {
    "name": "Thread Folders",
    "description": "Folders for the BB thread list: create, rename, and delete folders and file threads into them from the CLI or agent tools.",
    "branding": {
      "icon": "Folder"
    },
    "server": "./server.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.49",
    "@pierre/diffs": "^1.2.9",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.0.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "sdk:check": "bb plugin types . --check",
    "test": "node --experimental-strip-types --test server.test.ts"
  }
}
